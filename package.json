{
  "name": "elevate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The web, compiled for agents. Compile a website's actions once, replay them near-free through a uniform MCP/API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
